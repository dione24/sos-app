    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.23",
    "expo-network": "~57.0.3",
    "expo-router": "~57.0.30",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.25",
    "expo-sms": "~57.0.2",
    "expo-splash-screen": "~57.0.11",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
