    "record:fgs-demo": "bash scripts/record-play-fgs-demo.sh"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@maplibre/maplibre-react-native": "^11.3.6",
    "expo": "~57.0.32",
    "expo-asset": "~57.0.10",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.23",
    "expo-clipboard": "~57.0.2",
