{
  "name": "sos-securite-mali",
  "version": "1.0.2",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "patch-package --error-on-fail",
    "verify:android-manifest": "bash scripts/verify-android-manifest.sh",
    "verify:android-release": "bash scripts/verify-android-release.sh",
    "verify:fgs-video": "node scripts/verify-fgs-video.mjs",
    "verify:ios-config": "bash scripts/verify-ios-config.sh",
    "verify:ios-assets": "bash scripts/verify-ios-assets.sh",
    "verify:guide-audio": "bash scripts/verify-guide-audio.sh",
    "verify:play-submission": "bash scripts/verify-play-submission.sh",
